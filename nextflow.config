params {
    genome = null
    rnaseq = null
    proteins = null
    eviann_args = '' // upstream defaults; CNN-Mamba runs as the following stage
    eviann_memory = '44 GB'
    eviann_src = "${projectDir}/eviann/bin" // install_eviann.py stages unchanged upstream scripts
    eviann_resume_dir = null
    eviann_reuse_annotation = false
    integrate_args = '' // upstream external-CDS integration with -c
    outdir = 'results'
    threads = 16
    annotation_env = null
    scoring_env = null

    min_seq_len = 100000
    segment_len = 0 // 0 keeps chromosomes whole
    ab_initio_decoder = 'uniann' // 'altann' replaces the native binary: less memory, about 3 times slower
    uniann_trace = false // keep the native DP/BT log, about 0.5 GB per Mb per strand
    segment_overlap = 4000000
    segment_margin = 20000

    // External checkout and existing GPU Python; no drivers/environments installed at runtime.
    cnn_mamba_dir = "${projectDir}/cnn-mamba"
    cnn_python = 'python'
    cnn_checkpoint = null           // supplied weights skip training
    cnn_calibration_json = null     // optional joint-four-class temperature, applied once
    cnn_fit_temperature = false     // fit on held-out EviAnn pseudo-labels, not a gold reference
    cnn_validation_chroms = []      // explicit disjoint FASTA records when training
    cnn_test_chroms = []
    cnn_include_test_in_train = false // train on test records too; validation keeps model selection
    cnn_window_size = 10000
    cnn_stride = 5000
    cnn_train_args = ''
    cnn_batch_size = 1

    uniann_dir = "${projectDir}/uniann"
    score_multiplier = 2.71828182845905 // site log-score scaling; not temperature calibration
    altann_dir = "${projectDir}/altann"
    altann_kbest = 10
    altann_flank = 1000
    altann_memory = '20 GB'
    uniann_kbest = null // deprecated alias
    kbest_delta_fraction = null
    integrate_novel_only = false
}

process {
    errorStrategy = 'terminate'
    withName: 'EVIANN|INTEGRATE' { cpus = params.threads; memory = params.eviann_memory }
    withName: 'CNN_.*' { cpus = 4; maxForks = 1; memory = '12 GB' }
    withName: UNIANN { cpus = 4; maxForks = 3 } // memory follows the sequence length; see modules/uniann.nf
    withName: ALTANN { cpus = 4; maxForks = 2; memory = params.altann_memory }
}

profiles {
    local_envs {
        conda.enabled = true
        process.conda = params.annotation_env ?: "${projectDir}/environment.yml"
        process { withName: 'CNN_.*' { conda = params.scoring_env ?: null } }
    }
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
        process { withName: 'CNN_.*' { conda = params.scoring_env ?: null } }
    }
}
trace { overwrite = true }
report { overwrite = true }
