params {
    genome        = null      // MANDATORY genome FASTA
    rnaseq        = null      // EviAnn -r: list file of RNA-seq inputs (absolute paths)
    proteins      = null      // EviAnn -p: related-species protein FASTA
    eviann_args   = ''        // extra eviann.sh options
    eviann_src    = null      // dir with a newer eviann.sh + helper scripts, prepended to PATH (e.g. fork src/); INTEGRATE needs --untrusted-cds
    outdir        = 'results'
    threads       = 16

    min_seq_len   = 100000    // shorter sequences get no ab initio track (EviAnn only)
    psauron_chunk = 4500000   // nt per psauron call (memory ~1 GB per Mb)

    uniann_dir    = "${projectDir}/uniann"   // UniAnn submodule; run install.sh there first
    uniann_args   = '-n'      // extra uniann.sh options

    // Site scorer stage (README "Bring your own site scorer"). Defaults = sitescore submodule.
    site_train_cmd    = null    // template: {genome} {annotation} {model_dir}; null = sitescore
    site_score_cmd    = null    // template: {model_dir} {fasta}; must print sites.tsv to stdout
    site_model_dir    = null    // ready model_dir: skips SITE_TRAIN
    site_scorer_env   = "${projectDir}/sitescore/environment.yml"   // conda yml or env path for SITE_* (conda profile)
    sitescore_model   = 'convmamba'   // sitescore only: plug-in name (`sitescore models`)
    sitescore_init    = null    // sitescore only: pretrained model_dir to fine-tune from
    sitescore_hparams = null    // sitescore only: JSON forwarded to the model
}

process {
    errorStrategy = 'terminate'
    withName: 'EVIANN|INTEGRATE' { cpus = params.threads }
    withName: PSAURON  { cpus = 4; maxForks = 4 }               // CPU only, runs alongside EviAnn
    withName: 'SITE_.*' { maxForks = 1; errorStrategy = 'retry'; maxRetries = 1 }   // the GPU stage
    withName: UNIANN  { cpus = 4 }
}

profiles {
    // Existing conda envs on this machine (no env solving at run time)
    local_envs {
        conda.enabled = true
        process.conda = '/home/hibiki/miniforge3/envs/eviann'
        process { withName: 'PSAURON|SITE_.*' { conda = '/home/hibiki/miniforge3/envs/mamba3_env' } }
    }
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
        // the site scorer (sitescore: PyTorch/CUDA) gets its own environment; point
        // site_scorer_env at your own yml or env path when replacing the scorer
        process { withName: 'SITE_.*' { conda = params.site_scorer_env } }
    }
}

trace  { overwrite = true }
report { overwrite = true }
