params {
    genome        = null      // MANDATORY genome FASTA
    rnaseq        = null      // EviAnn -r: list file of RNA-seq inputs (absolute paths)
    proteins      = null      // EviAnn -p: related-species protein FASTA
    eviann_args   = ''        // extra eviann.sh options
    eviann_src    = null      // dir with a newer eviann.sh + helper scripts, prepended to PATH (e.g. fork src/); INTEGRATE needs --untrusted-cds
    outdir        = 'results'
    threads       = 16

    min_seq_len   = 100000    // shorter sequences get no ab initio track (EviAnn only)
    psauron_chunk = 4500000   // nt per psauron call (~1 GB GPU per Mb)

    uniann_dir    = "${projectDir}/uniann"   // UniAnn submodule; run install.sh there first
    uniann_args   = '-n'      // extra uniann.sh options

    // Site evaluator (sitescore submodule); see docs/contracts.md
    sitescore_model   = 'convmamba'   // plug-in name (`sitescore models`)
    sitescore_init    = null    // pretrained model_dir to fine-tune from
    sitescore_hparams = null    // JSON string forwarded to the model
}

process {
    errorStrategy = 'terminate'
    withName: 'EVIANN|INTEGRATE' { cpus = params.threads }
    // One 12 GB GPU: serialize GPU tasks; on OOM retry PSAURON on CPU
    withName: PSAURON { cpus = 8; maxForks = 1; errorStrategy = 'retry'; maxRetries = 1 }
    withName: 'SITESCORE_.*' { maxForks = 1; errorStrategy = 'retry'; maxRetries = 1 }
    withName: UNIANN  { cpus = 4 }
}

profiles {
    // Existing conda envs on this machine (no env solving at run time)
    local_envs {
        conda.enabled = true
        process.conda = '/home/hibiki/miniforge3/envs/eviann'
        process { withName: 'PSAURON|SITESCORE_.*' { conda = '/home/hibiki/miniforge3/envs/mamba3_env' } }
    }
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
        // sitescore models are PyTorch/CUDA; they get their own environment
        process { withName: 'SITESCORE_.*' { conda = "${projectDir}/sitescore/environment.yml" } }
    }
}
